# Wix CMS
WIX_API_KEY=
WIX_SITE_ID=
# Actual Wix CMS collection ID for the Events collection.
# Do not replace with "Events" unless the CMS collection ID changes.
WIX_COLLECTION_EVENTS_ID=Import4
# Actual Wix CMS collection ID for the footer newsletter Subscribe collection.
WIX_SUBSCRIBE_COLLECTION_ID=
# Optional. Defaults to "email" when the Subscribe collection email field key is email.
WIX_SUBSCRIBE_EMAIL_FIELD_KEY=email
# Optional. Defaults to "subscribedAt" when the Subscribe collection Date & Time field key is subscribedAt.
WIX_SUBSCRIBE_DATE_FIELD_KEY=subscribedAt
# Optional. Use if the PartnershipPage collection ID cannot be discovered by name.
WIX_COLLECTION_PARTNERSHIP_PAGE_ID=
# Preferred stable lookup for PartnershipPage. If unset, WIX_PARTNERSHIP_PAGE_KEY is used.
WIX_PARTNERSHIP_PAGE_RECORD_ID=
# Stable PartnershipPage key. Defaults to "partnership-main".
WIX_PARTNERSHIP_PAGE_KEY=partnership-main

# Partnership enquiry Gmail API
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=
GOOGLE_GMAIL_SENDER_EMAIL=helen.y@castiglione.com.au
# Emergency fallback only. Preferred recipients come from PartnershipPage.recipientEmails in Wix CMS.
# Supports comma-separated recipients, for example: first@example.com, second@example.com
PARTNERSHIP_EMAIL_TO=
